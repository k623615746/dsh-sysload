{
  "name": "dsh-sysload",
  "version": "1.0.0",
  "description": "Live CPU, GPU and memory load in the DeepSeek Harness Session header.",
  "type": "module",
  "license": "MIT",
  "author": "Ximing (https://github.com/k623615746)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/k623615746/dsh-sysload.git"
  },
  "homepage": "https://github.com/k623615746/dsh-sysload#readme",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek",
    "harness",
    "system-monitor",
    "cpu",
    "gpu",
    "memory"
  ],
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  }
}
